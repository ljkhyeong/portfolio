# k3s의 ConfigMap/Secret에 옮길 예시입니다. 이미지에 복사하지 않습니다.
# 키가 없는 상태에서도 기동하도록 AI는 기본 비활성화합니다.
# 주석의 값은 애플리케이션 기본값입니다. 빈 값도 기본값을 덮어쓰므로 바꿀 항목만 Pod 환경변수로 전달합니다.
SPRING_PROFILES_ACTIVE=homeserver
ELASTICSEARCH_URL=http://elasticsearch:9200
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
# 내부 동기화·상태 API 키(Secret)입니다. 비어 있으면 두 API를 모두 거부합니다.
KNOWLEDGE_SYNC_KEY=
KNOWLEDGE_CORS_ALLOWED_ORIGINS=https://ljkportfolio.netlify.app
# homeserver 프로필은 관리 포트 9091과 시작 시 동기화를 켭니다.
# KNOWLEDGE_SYNC_ON_STARTUP=true
# KNOWLEDGE_SOURCE_MAX_BYTES=8388608
# PORT=8080

# OpenAI를 켤 때 SPRING_PROFILES_ACTIVE=homeserver,openai로, AI Gateway를 거칠 때 homeserver,ai-gateway로 지정합니다.
# 다음 동기화가 OpenAI 임베딩으로 새 색인을 만들어 검색 대상을 교체합니다.
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-5-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# OPENAI_EMBEDDING_DIMENSIONS=1024
# OPENAI_REQUEST_TIMEOUT=30s
# OPENAI_MAX_COMPLETION_TOKENS=2000

# 사이트 키는 React 빌드 환경에, 아래 비밀 키는 API Secret에 설정합니다.
# KNOWLEDGE_TURNSTILE_ENABLED=false
# KNOWLEDGE_TURNSTILE_SECRET_KEY=
# KNOWLEDGE_TURNSTILE_EXPECTED_HOSTNAMES=ljkportfolio.netlify.app

# KNOWLEDGE_RATE_LIMIT_GLOBAL_ANSWERS_PER_MINUTE=30
# KNOWLEDGE_RATE_LIMIT_CLIENT_ANSWERS_PER_MINUTE=5
# KNOWLEDGE_RATE_LIMIT_GLOBAL_SEARCHES_PER_MINUTE=300
# KNOWLEDGE_RATE_LIMIT_CLIENT_SEARCHES_PER_MINUTE=30
# KNOWLEDGE_RATE_LIMIT_MAX_CLIENTS_PER_MINUTE=100
# KNOWLEDGE_AI_ANSWER_CACHE_TTL_SECONDS=120
# KNOWLEDGE_AI_ANSWER_CACHE_MAX_ENTRIES=128
