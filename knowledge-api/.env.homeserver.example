# k3s의 ConfigMap/Secret에 옮길 예시입니다. 이미지에 복사하지 않습니다.
# 키가 없는 상태에서도 기동하도록 AI는 기본 비활성화합니다.
SPRING_PROFILES_ACTIVE=homeserver
AI_PROFILE=disabled
PORT=8080
MANAGEMENT_SERVER_PORT=9091
MANAGEMENT_SERVER_ADDRESS=0.0.0.0
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=portfolio-knowledge-disabled-v3
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
KNOWLEDGE_SYNC_ON_STARTUP=true
KNOWLEDGE_SYNC_KEY=
KNOWLEDGE_CORS_ALLOWED_ORIGINS=https://ljkportfolio.netlify.app

# OpenAI를 켤 때 SPRING_PROFILES_ACTIVE=homeserver,openai 및 AI_PROFILE=openai를 함께 지정합니다.
# ELASTICSEARCH_INDEX도 portfolio-knowledge-openai-v3로 바꿉니다.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1024
OPENAI_REQUEST_TIMEOUT=30s
OPENAI_SDK_MAX_RETRIES=0
AI_RETRY_MAX_ATTEMPTS=2
OPENAI_MAX_COMPLETION_TOKENS=2000

# 사이트 키는 React 빌드 환경에, 아래 비밀 키는 API Secret에 설정합니다.
KNOWLEDGE_TURNSTILE_ENABLED=false
KNOWLEDGE_TURNSTILE_SECRET_KEY=
KNOWLEDGE_TURNSTILE_EXPECTED_HOSTNAMES=ljkportfolio.netlify.app

AI_GLOBAL_ANSWERS_PER_MINUTE=30
AI_CLIENT_ANSWERS_PER_MINUTE=5
AI_GLOBAL_SEARCHES_PER_MINUTE=300
AI_CLIENT_SEARCHES_PER_MINUTE=30
AI_MAX_CLIENT_BUCKETS_PER_MINUTE=100
AI_ANSWER_CACHE_TTL_SECONDS=120
AI_ANSWER_CACHE_MAX_ENTRIES=128
# 신뢰하는 프록시가 전달 헤더를 덮어쓸 때만 켭니다.
AI_TRUST_PROXY_HEADERS=false
