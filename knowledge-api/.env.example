# docker compose가 읽는 예시입니다. .env로 복사한 뒤 바꿀 줄만 주석을 풀어 값을 지정합니다.
# 주석의 값은 애플리케이션 기본값입니다. 빈 값(KEY=)도 기본값을 덮어쓰므로 쓰지 않을 항목은 주석으로 둡니다.

# AI 프로필입니다. 지정하지 않으면 AI 없이 BM25 검색만 제공합니다.
# openai, ollama, ai-gateway(openai를 함께 켬) 중 하나를 사용하며 homeserver는 Compose가 항상 포함합니다.
# SPRING_PROFILES_ACTIVE=openai

# OpenAI 프로필에서 사용합니다. API 키는 필수입니다.
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-5-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# OPENAI_EMBEDDING_DIMENSIONS=1024
# OPENAI_REQUEST_TIMEOUT=30s
# OPENAI_MAX_COMPLETION_TOKENS=2000

# Ollama 프로필에서 사용합니다.
# OLLAMA_CHAT_MODEL=qwen3:8b
# OLLAMA_EMBEDDING_MODEL=bge-m3
# OLLAMA_EMBEDDING_DIMENSIONS=1024

# 이미지에 포함된 공개 자료의 최대 크기(바이트)입니다.
# KNOWLEDGE_SOURCE_MAX_BYTES=8388608
# Compose의 homeserver 프로필은 시작 시 동기화를 켭니다.
# KNOWLEDGE_SYNC_ON_STARTUP=true
# 내부 동기화·상태 API 키입니다. 비어 있으면 두 API를 모두 거부합니다.
# KNOWLEDGE_SYNC_KEY=
# KNOWLEDGE_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://ljkportfolio.netlify.app

# AI 답변 API의 자동 호출을 막습니다. 프런트엔드의 VITE_KNOWLEDGE_TURNSTILE_SITE_KEY와 함께 설정합니다.
# KNOWLEDGE_TURNSTILE_ENABLED=false
# KNOWLEDGE_TURNSTILE_SECRET_KEY=
# KNOWLEDGE_TURNSTILE_EXPECTED_HOSTNAMES=ljkportfolio.netlify.app

# 같은 질문과 근거의 답변을 잠시 재사용합니다. TTL을 0으로 두면 캐시하지 않습니다. 최대 개수는 1 이상입니다.
# KNOWLEDGE_AI_ANSWER_CACHE_TTL_SECONDS=120
# KNOWLEDGE_AI_ANSWER_CACHE_MAX_ENTRIES=128

# 분당 호출 제한입니다. 0 이하이면 해당 한도를 적용하지 않습니다.
# KNOWLEDGE_RATE_LIMIT_GLOBAL_ANSWERS_PER_MINUTE=30
# KNOWLEDGE_RATE_LIMIT_CLIENT_ANSWERS_PER_MINUTE=5
# KNOWLEDGE_RATE_LIMIT_GLOBAL_SEARCHES_PER_MINUTE=300
# KNOWLEDGE_RATE_LIMIT_CLIENT_SEARCHES_PER_MINUTE=30
# KNOWLEDGE_RATE_LIMIT_MAX_CLIENTS_PER_MINUTE=100
