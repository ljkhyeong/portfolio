# disabled, openai, ollama 중 하나를 사용합니다.
AI_PROFILE=disabled

# OpenAI 프로필에서만 필요합니다.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1024
OPENAI_REQUEST_TIMEOUT=30s
# Spring AI 재시도만 사용해 중복 재시도를 막습니다.
OPENAI_SDK_MAX_RETRIES=0
AI_RETRY_MAX_ATTEMPTS=2
OPENAI_MAX_COMPLETION_TOKENS=2000

# Ollama 프로필에서 사용합니다.
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_DIMENSIONS=1024

# 비워두면 프로필별 기본 인덱스 이름을 사용합니다. 모델을 바꾸면 새 이름을 지정하세요.
ELASTICSEARCH_INDEX=
KNOWLEDGE_SOURCE_LOCATION=classpath:knowledge/portfolio.json
KNOWLEDGE_SYNC_ON_STARTUP=true
KNOWLEDGE_ALLOW_EMPTY=false
KNOWLEDGE_SYNC_KEY=
KNOWLEDGE_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://ljkportfolio.netlify.app

# AI 답변 API의 자동 호출을 막습니다. 프런트엔드의 VITE_KNOWLEDGE_TURNSTILE_SITE_KEY와 함께 설정합니다.
KNOWLEDGE_TURNSTILE_ENABLED=false
KNOWLEDGE_TURNSTILE_SECRET_KEY=
KNOWLEDGE_TURNSTILE_EXPECTED_HOSTNAMES=ljkportfolio.netlify.app

AI_GLOBAL_ANSWERS_PER_MINUTE=30
AI_CLIENT_ANSWERS_PER_MINUTE=5
# 같은 질문과 근거의 답변을 잠시 재사용합니다. 둘 중 하나를 0으로 두면 캐시하지 않습니다.
AI_ANSWER_CACHE_TTL_SECONDS=120
AI_ANSWER_CACHE_MAX_ENTRIES=128
AI_GLOBAL_SEARCHES_PER_MINUTE=300
AI_CLIENT_SEARCHES_PER_MINUTE=30
AI_MAX_CLIENT_BUCKETS_PER_MINUTE=100
# 신뢰하는 프록시가 X-Forwarded-For를 덮어쓸 때만 true로 설정합니다.
AI_TRUST_PROXY_HEADERS=false
